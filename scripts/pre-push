#!/usr/bin/env bash
# Local guard: block direct pushes to master. Work on develop and merge via PR.
# Install:  ln -sf ../../scripts/pre-push .git/hooks/pre-push
# Bypass (when you really mean it):  git push --no-verify
set -euo pipefail

protected="refs/heads/master"
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "$protected" ]; then
    echo "pre-push: direct push to master is blocked." >&2
    echo "          Push 'develop' and open a PR, or bypass with --no-verify." >&2
    exit 1
  fi
done
exit 0
